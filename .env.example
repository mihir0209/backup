# Backup — environment variables
# Copy to .env and edit. .env is gitignored; .env.example is committed.
# Loaded automatically by backup.py (no external deps).

# --- Google Drive via rclone (primary) ---
# Remote as created with `rclone config` — see docs/google-drive-upload-research.md
# Example full workflow:
#   1. Create Cloud project → Enable Drive API → OAuth consent → Desktop client
#   2. rclone config → n → name=gdrive → drive → paste client_id/secret → scope=1 → y
#   3. Test: rclone lsd gdrive:  && rclone mkdir gdrive:Backups
GDRIVE_REMOTE=gdrive:Backups

# Optional: custom rclone config path (otherwise ~/.config/rclone/rclone.conf)
# RCLONE_CONFIG=/home/ghostrider/.config/rclone/rclone.conf

# Optional: inline client_id/secret via env (alternative to rclone.conf entry)
# RCLONE_DRIVE_CLIENT_ID=123456789.apps.googleusercontent.com
# RCLONE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxx

# Optional: extra rclone flags appended to every rclone copy
# RCLONE_ARGS=--transfers 4 --checkers 8 --tpslimit 5 --bwlimit 10M --buffer-size 16M

# --- Physically connected drive (local copy) ---
# Mount point of your USB/external drive. Must be mounted before backup.
# Linux typical: /media/<user>/<label> or /mnt/backup
# macOS typical: /Volumes/Backup
# Windows typical: D:\Backups  (use /mnt/d/Backups in WSL)
BACKUP_COPY_TARGET=/media/backup-drive/backups

# Optional: set to 1 to fail backup if the copy target is not a mountpoint (safety)
# BACKUP_COPY_REQUIRE_MOUNT=0

# --- Archive encryption (optional, 7z AES-256) ---
# Enable via archive.encryption in request.json, then provide the passphrase ONE way:
#   1. prompt (default): interactively asked once at startup, before sudo elevation
#   2. env: export BACKUP_PASSPHRASE='...'  (wins in every mode; never captured into backups)
#   3. keyring: python3 backup.py --store-passphrase  (needs: pip install keyring)
# BACKUP_PASSPHRASE=

# --- General ---
# Override workers/compression via env instead of editing request.json
# BACKUP_WORKERS=4
# BACKUP_LEVEL=6
